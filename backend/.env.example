#
# FormFlow now uses backend/config/config.php instead of .env files.
# This provides zero-configuration setup out of the box!
#
# To customize settings, edit:
#   backend/config/config.php
#
# No .env file is needed - just edit the PHP config directly.
# This makes deployment simpler and more maintainable.
#
